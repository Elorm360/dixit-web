# Public site URL (used for SEO links and social previews)
NEXT_PUBLIC_SITE_URL=https://dixit-web.vercel.app

# --- Enquiry email (Resend: https://resend.com) ---
RESEND_API_KEY=re_replace_with_your_key
# Where enquiries are delivered. Comma-separate for several addresses.
ENQUIRY_EMAIL_TO=you@example.com
# Sender. Keep the default until you verify your own domain in Resend.
ENQUIRY_EMAIL_FROM=DIXIT Website <onboarding@resend.dev>

# --- Optional: also store enquiries in Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://jomykqytajmytehjdslg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_project_key
